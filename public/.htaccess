# ============================
# Gestionale Fotografo - .htaccess
# ============================

# Disabilita i rewrite di WordPress per questa cartella
RewriteEngine Off

# File di default della cartella
DirectoryIndex login.php

# Protezione base: impedisce accesso diretto ai file .htaccess o file sensibili
# I file in questa lista (config.php, db.php, ecc.) NON saranno accessibili direttamente
<FilesMatch "^(\.htaccess|config\.php|db\.php|auth\.php|movements\.php)$">
    Require all denied
</FilesMatch>

# LA SEZIONE SEGUENTE È STATA RIMOSSA/COMMENTATA PER CONSENTIRE
# L'ACCESSO DIRETTO ALLE ALTRE PAGINE PHP (es. dashboard.php, ecc.)

